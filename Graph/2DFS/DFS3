class Solution {
    int nodesCount=0;
    int edgeCount=0;
    public int countCompleteComponents(int n, int[][] edges) {
        List<List<Integer>> graph = new ArrayList<>();
        for (int i = 0; i < n; i++) {
            graph.add(new ArrayList<>());
        }
        for (int[] e : edges) {
            int u = e[0];
            int v = e[1];
            graph.get(u).add(v);
            graph.get(v).add(u);
        }
        int ans = 0;
        boolean[] visited = new boolean[n];
        for (int i = 0; i < n; i++) {
            nodesCount=0;
            edgeCount=0;
            if (!visited[i]) {
                visited[i] = true;
                dfs(i,graph,visited);
                if(edgeCount==(nodesCount)*(nodesCount-1)) ans++;
            }
        }
        return ans;
    }
    void dfs(int node,List<List<Integer>> graph,boolean[] visited) {
        visited[node] = true;
        nodesCount++;
        edgeCount+=graph.get(node).size();
        for (int neighbor : graph.get(node)) {
            if (!visited[neighbor]) {
                dfs(neighbor,graph,visited);
            }
        }
    }
}