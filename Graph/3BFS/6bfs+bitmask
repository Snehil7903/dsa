import java.util.*;

class Solution {
    public int minMoves(String[] classroom, int energy) {

        int m = classroom.length;
        int n = classroom[0].length();

        // litterId[i][j] tells which litter is at (i,j)
        int[][] litterId = new int[m][n];

        for (int[] row : litterId) {
            Arrays.fill(row, -1);
        }

        int startR = 0;
        int startC = 0;
        int litterCount = 0;

        // Find S and number the litter cells
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {

                char c = classroom[i].charAt(j);

                if (c == 'S') {
                    startR = i;
                    startC = j;
                }

                if (c == 'L') {
                    litterId[i][j] = litterCount++;
                }
            }
        }

        // No litter -> already clean
        if (litterCount == 0) {
            return 0;
        }

        int allMask = (1 << litterCount) - 1;

        /*
         * visited[row][col][energy][mask]
         *
         * Has this exact state been visited?
         */
        boolean[][][][] visited =
            new boolean[m][n][energy + 1][1 << litterCount];

        /*
         * State:
         * [row, col, remainingEnergy, mask]
         */
        Queue<int[]> queue = new LinkedList<>();

        queue.offer(new int[] {
            startR,
            startC,
            energy,
            0
        });

        visited[startR][startC][energy][0] = true;

        int[] dr = {-1, 1, 0, 0};
        int[] dc = {0, 0, -1, 1};

        int moves = 0;

        while (!queue.isEmpty()) {

            int size = queue.size();

            // Process one BFS level
            while (size-- > 0) {

                int[] state = queue.poll();

                int r = state[0];
                int c = state[1];
                int currEnergy = state[2];
                int mask = state[3];

                // All litter collected
                if (mask == allMask) {
                    return moves;
                }

                // No energy means we cannot move.
                // If we are on R, energy would already have
                // been reset when we entered it.
                if (currEnergy == 0) {
                    continue;
                }

                for (int d = 0; d < 4; d++) {

                    int nr = r + dr[d];
                    int nc = c + dc[d];

                    // Outside grid
                    if (nr < 0 || nr >= m ||
                        nc < 0 || nc >= n) {
                        continue;
                    }

                    // Obstacle
                    if (classroom[nr].charAt(nc) == 'X') {
                        continue;
                    }

                    /*
                     * Moving normally costs 1 energy.
                     */
                    int nextEnergy = currEnergy - 1;

                    /*
                     * If we enter R, reset energy completely.
                     */
                    if (classroom[nr].charAt(nc) == 'R') {
                        nextEnergy = energy;
                    }

                    /*
                     * Update litter mask.
                     */
                    int nextMask = mask;

                    if (classroom[nr].charAt(nc) == 'L') {

                        int id = litterId[nr][nc];

                        nextMask |= (1 << id);
                    }

                    /*
                     * Avoid visiting the exact same state again.
                     */
                    if (!visited[nr][nc][nextEnergy][nextMask]) {

                        visited[nr][nc][nextEnergy][nextMask] = true;

                        queue.offer(new int[] {
                            nr,
                            nc,
                            nextEnergy,
                            nextMask
                        });
                    }
                }
            }

            moves++;
        }

        return -1;
    }
}