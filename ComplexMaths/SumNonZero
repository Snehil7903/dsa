3754. Concatenate Non-Zero Digits and Multiply by Sum I

class Solution {
    public long sumAndMultiply(int n) {
        long temp = n;
        long sum=0;
        long num=0;
        long multiplier=1;
        while(temp>0){
            long digit = temp%10;
            if(digit!=0){
            num =num+ (digit*multiplier);
            multiplier = multiplier*10;
            }
            sum = sum+digit;
            temp = temp/10;
        }
        return num*sum;
    }
}